# SPDXLIMS production backend environment template
#
# Copy this file to .env on the server and replace every CHANGE_ME value.
# Do not commit the real .env file.

APP_ENV=production

# PostgreSQL database used by the backend.
# Example:
# DATABASE_URL=postgresql+psycopg://spdxlims_app:CHANGE_ME_PASSWORD@127.0.0.1:5432/spdxlims_prod
DATABASE_URL=postgresql+psycopg://spdxlims_app:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/spdxlims_prod

# Generate a long random value for production.
# PowerShell example:
# -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256

# Comma-separated origins allowed to call the API from browser/admin UI.
# Desktop API calls are not browser CORS-bound, but the admin UI is.
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Backup status file read by /api/operations/backup-status.
BACKUP_STATUS_PATH=C:\SPDXLIMS\backend\backup-status.json
BACKUP_CONFIG_PATH=C:\SPDXLIMS\backend\backup-config.json

# Operational paths used by scripts/runbooks.
SPDXLIMS_BACKUP_DIR=C:\SPDXLIMS\backups
SPDXLIMS_UPLOAD_DIR=C:\SPDXLIMS\backend\app\static\uploads
SPDXLIMS_PG_BIN=C:\Program Files\PostgreSQL\18\bin

# Initial seed credentials. Rotate after deployment and keep out of source control.
SEED_ADMIN_EMAIL=admin@spdxlims.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
