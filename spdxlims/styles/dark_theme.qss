QWidget {
    background-color: #0B1118;
    color: #F4F7FB;
    font-family: "Segoe UI";
    font-size: 12pt;
}

QMainWindow, QDialog, QScrollArea, QStackedWidget {
    background-color: #0B1118;
}

QScrollArea {
    border: none;
}

QLabel {
    background: transparent;
    color: #F4F7FB;
}

QLabel#orderCardTitle {
    color: #F4F7FB;
    font-size: 14pt;
    font-weight: 700;
}

QLabel#ordersHelper,
QLabel#emptyPanelsSubtitle,
QLabel#accountName {
    color: #A8B3C2;
    font-size: 10pt;
}

QLabel#emptyPanelsTitle {
    color: #F4F7FB;
    font-size: 12pt;
    font-weight: 700;
}

QLabel#emptyPanelsIcon {
    background-color: #162132;
    border: 1px solid #30415A;
    border-radius: 26px;
    color: #9B6CF3;
    font-size: 22pt;
    font-weight: 300;
    min-width: 42px;
    min-height: 42px;
    max-width: 42px;
    max-height: 42px;
}

QWidget#ordersPage {
    background-color: #0B1118;
}

QGroupBox,
QFrame[class="orderCard"],
QFrame#orderTopControls,
QFrame#orderFormShell,
QFrame#recentOrdersGroup {
    background-color: #111B27;
    border: 1px solid #243244;
    border-radius: 12px;
}

QGroupBox {
    margin-top: 18px;
    padding: 16px 14px 14px 14px;
    font-size: 13pt;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    color: #F4F7FB;
    background-color: #111B27;
}

QWidget#orderSelectedShell {
    background-color: transparent;
}

QWidget#emptyPanelsState {
    background-color: #0D141D;
    border: 1px dashed #30415A;
    border-radius: 14px;
}

QLabel#workspaceLabel {
    background-color: #162132;
    border: 1px solid #243244;
    border-radius: 12px;
    color: #A8B3C2;
    font-size: 10pt;
    font-weight: 700;
    padding: 9px 12px;
}

QWidget#navSidebar {
    background-color: #101721;
    border-right: 1px solid #1C2938;
}

QListWidget#navDrawer {
    background-color: transparent;
    border: none;
    outline: 0;
    padding: 4px 0;
}

QListWidget#navDrawer::item {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    color: #A8B3C2;
    min-height: 52px;
    padding: 7px 10px;
}

QListWidget#navDrawer::item:hover {
    background-color: #162132;
    border-color: #243244;
    color: #F4F7FB;
}

QListWidget#navDrawer::item:selected {
    background-color: #5B2AA8;
    border-color: #9B6CF3;
    color: #FFFFFF;
}

QFrame#accountBlock {
    background-color: #111B27;
    border: 1px solid #243244;
    border-radius: 14px;
}

QLabel#accountRole {
    color: #F4F7FB;
    font-size: 12pt;
    font-weight: 800;
}

QPushButton#workspaceSelector {
    background-color: #111B27;
    border: 1px solid #243244;
    border-radius: 10px;
    color: #A8B3C2;
    font-size: 9pt;
    font-weight: 700;
    min-height: 28px;
    padding: 4px 0;
}

QPushButton#workspaceSelector:hover {
    background-color: #162132;
    border-color: #30415A;
    color: #F4F7FB;
}

QPushButton#workspaceSelector:checked {
    background-color: #5B2AA8;
    border-color: #9B6CF3;
    color: #FFFFFF;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit, QComboBox {
    background-color: #0D141D;
    border: 1px solid #243244;
    border-radius: 10px;
    color: #F4F7FB;
    min-height: 32px;
    padding: 4px 9px;
    selection-background-color: #9B6CF3;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QDateTimeEdit:focus, QComboBox:focus {
    border: 1px solid #9B6CF3;
}

QLineEdit:read-only {
    color: #A8B3C2;
}

QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: #0D141D;
    border: 1px solid #243244;
    color: #F4F7FB;
    outline: 0;
    selection-background-color: #5B2AA8;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background-color: #162132;
    border: none;
    width: 20px;
}

QCheckBox {
    background: transparent;
    color: #F4F7FB;
    spacing: 8px;
}

QCheckBox::indicator {
    background-color: #0D141D;
    border: 1px solid #30415A;
    border-radius: 5px;
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:hover {
    border-color: #9B6CF3;
}

QCheckBox::indicator:checked {
    background-color: #7F4DE0;
    border-color: #9B6CF3;
}

QRadioButton {
    background: transparent;
    color: #F4F7FB;
    spacing: 8px;
}

QRadioButton::indicator {
    background-color: #0D141D;
    border: 1px solid #30415A;
    border-radius: 9px;
    width: 18px;
    height: 18px;
}

QRadioButton::indicator:checked {
    background-color: #7F4DE0;
    border: 4px solid #0D141D;
}

QPushButton {
    border-radius: 10px;
    font-size: 10pt;
    font-weight: 700;
    min-height: 32px;
    padding: 5px 11px;
}

QPushButton,
QPushButton[class="primaryButton"] {
    background-color: #7F4DE0;
    border: 1px solid #9B6CF3;
    color: #FFFFFF;
}

QPushButton:hover,
QPushButton[class="primaryButton"]:hover {
    background-color: #9B6CF3;
    border-color: #B894F7;
}

QPushButton:pressed,
QPushButton[class="primaryButton"]:pressed {
    background-color: #5B2AA8;
    border-color: #7F4DE0;
}

QPushButton[class="secondaryButton"] {
    background-color: #111B27;
    border: 1px solid #30415A;
    color: #F4F7FB;
}

QPushButton[class="secondaryButton"]:hover {
    background-color: #162132;
    border-color: #566985;
}

QPushButton[class="secondaryButton"]:pressed {
    background-color: #0D141D;
    border-color: #9B6CF3;
}

QPushButton:disabled {
    background-color: #1C2735;
    border-color: #243244;
    color: #697789;
}

QHeaderView::section {
    background-color: #162132;
    border: none;
    border-bottom: 1px solid #243244;
    color: #A8B3C2;
    font-size: 10pt;
    font-weight: 700;
    padding: 6px 8px;
}

QTableWidget, QTableView, QListWidget, QTreeWidget {
    background-color: transparent;
    border: none;
    color: #F4F7FB;
    gridline-color: transparent;
    outline: 0;
    selection-background-color: #32204E;
    selection-color: #FFFFFF;
}

QTableWidget::item, QListWidget::item, QTreeWidget::item {
    background-color: transparent;
    border-bottom: 1px solid #243244;
    padding: 5px 8px;
}

QTableWidget::item:hover, QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #162132;
}

QTableWidget::item:selected, QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #32204E;
    color: #FFFFFF;
}

QTableCornerButton::section {
    background-color: #162132;
    border: none;
    border-bottom: 1px solid #243244;
}

QTableWidget#recentOrdersTable,
QTableWidget#selectedPanelsTable,
QTableWidget#recentPatientsTable,
QTableWidget#catalogTestsTable,
QTableWidget#catalogPanelsTable,
QTableWidget#equipmentTable {
    background-color: #0D141D;
    border: 1px solid #243244;
    border-radius: 12px;
}

QTabWidget::pane {
    background-color: #111B27;
    border: 1px solid #243244;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background-color: #0D141D;
    border: 1px solid #243244;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    color: #A8B3C2;
    min-height: 30px;
    padding: 7px 14px;
}

QTabBar::tab:hover {
    background-color: #162132;
    color: #F4F7FB;
}

QTabBar::tab:selected {
    background-color: #5B2AA8;
    border-color: #9B6CF3;
    color: #FFFFFF;
}

QSplitter::handle {
    background-color: #1C2938;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #0B1118;
    border: none;
    margin: 0;
}

QScrollBar:vertical {
    width: 10px;
}

QScrollBar:horizontal {
    height: 10px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #30415A;
    border-radius: 5px;
    min-height: 28px;
    min-width: 28px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #566985;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

QStackedWidget#selectedPanelsStack {
    background-color: transparent;
    border: none;
}

QStatusBar {
    background-color: #101721;
    border-top: 1px solid #243244;
    color: #A8B3C2;
}
